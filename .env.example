# Frontend (Vite)
VITE_NEWSLETTER_ENDPOINT=/api/subscribe
VITE_NEWSLETTER_NOTIFY_EMAIL=notify@yourdomain.com

# Optional analytics
VITE_GA_MEASUREMENT_ID=

# Serverless API (Vercel Environment Variables → Production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — reuse the same Resend account as Caenna on day 1
RESEND_API_KEY=
RESEND_FROM_EMAIL=Launch <hello@yourdomain.com>

# Team notify on each new subscriber (comma or ; separated)
SUBSCRIBE_NOTIFY_EMAIL=notify@yourdomain.com

# Optional: auth for /api/send-launch-broadcast
NEWSLETTER_ADMIN_TOKEN=
